# include-what-you-use mapping of emeraude-base (owner decision 2026-10-19, plan Ave Robustus II P-W (2)): the files a
# lot touches come out IWYU-clean. The command lives in docs/static-analysis-ledger.md § include-what-you-use.
[
	# std::abs and std::size_t have several homes: the cascade's choice.
	{ "symbol": ["std::abs", "private", "<cmath>", "public"] },
	{ "symbol": ["abs", "private", "<cmath>", "public"] },
	{ "symbol": ["size_t", "private", "<cstddef>", "public"] },
	{ "symbol": ["std::size_t", "private", "<cstddef>", "public"] },
	{ "symbol": ["ptrdiff_t", "private", "<cstddef>", "public"] },
	# FreeType is included through its macros (FT_FREETYPE_H after ft2build.h).
	{ "include": ["@<freetype/.*>", "private", "\"ft2build.h\"", "public"] },
	# libjpeg, libpng, libtiff: their configuration headers come through the public one, in the order it sets (on Windows,
	# jconfig.h must precede jmorecfg.h: a direct <jmorecfg.h> redefined boolean / INT32, MSVC C2371).
	{ "include": ["<jmorecfg.h>", "private", "<jpeglib.h>", "public"] },
	{ "include": ["<jconfig.h>", "private", "<jpeglib.h>", "public"] },
	{ "include": ["<pngconf.h>", "private", "<png.h>", "public"] },
	{ "include": ["<pnglibconf.h>", "private", "<png.h>", "public"] },
	{ "include": ["<tiffconf.h>", "private", "<tiffio.h>", "public"] },
	{ "include": ["<tiff.h>", "private", "<tiffio.h>", "public"] },
	# asio is included through its umbrella headers, after the no-exceptions hook (Network/asio_throw_exception.hpp).
	{ "include": ["@<asio/ssl/.*>", "private", "\"asio/ssl.hpp\"", "public"] },
	{ "include": ["@<asio/.*>", "private", "\"asio.hpp\"", "public"] },
	# IWYU 0.23 with libstdc++ 14 attributes std::vector to <format>.
	{ "symbol": ["std::vector", "private", "<vector>", "public"] },
	# Apple's libc++ splits <cmath> and <cstring> into private headers IWYU 0.23's libc++ map does not know (macOS-PA,
	# 2026-10-25): they point at the public header.
	{ "include": ["@<__math/.*>", "private", "<cmath>", "public"] },
	{ "include": ["<_string.h>", "private", "<cstring>", "public"] },
	{ "include": ["@<__ostream/.*>", "private", "<ostream>", "public"] },
	{ "include": ["@<__vector/.*>", "private", "<vector>", "public"] },
	# glibc's <features.h> defines __GLIBC__ (a `#if defined(__GLIBC__)` guard): any standard header brings it, and the
	# header does not exist on macOS / Windows — never include it, point at a portable standard header instead. A SYMBOL
	# mapping: IWYU's built-in glibc map (loaded on every OS) declares <features.h> public, and an include entry that
	# says private makes IWYU 0.23 / 0.27 assert on every TU ("Same file seen with two different visibilities").
	{ "symbol": ["__GLIBC__", "private", "<cstddef>", "public"] }
]
